{
  "schema_version": 1,
  "events": {
    "project.account_auth_failed": {
      "event_schema_version": 1,
      "description": "A sign-in, sign-up or password reset request on the sign-in screen failed.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "sign_in",
              "sign_up",
              "password_reset"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "project.account_signed_in": {
      "event_schema_version": 1,
      "description": "A visitor signed in with email and password.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "email"
            ],
            "type": "string"
          }
        },
        "required": [
          "method"
        ],
        "type": "object"
      }
    },
    "project.account_signed_up": {
      "event_schema_version": 1,
      "description": "A new email account was created from the sign-in screen.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "confirmation_required": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "email"
            ],
            "type": "string"
          }
        },
        "required": [
          "method",
          "confirmation_required"
        ],
        "type": "object"
      }
    },
    "project.password_reset_completed": {
      "event_schema_version": 1,
      "description": "A new password was saved from a reset link.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "project.password_reset_requested": {
      "event_schema_version": 1,
      "description": "A password reset email was requested from the sign-in screen.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "project.wallet_authentication_failed": {
      "event_schema_version": 1,
      "description": "A Solana wallet authentication operation fails; bounded reason/stage distinguish signature cancellation from backend rejection, network problems, missing sessions, or unavailable adapters. Raw errors and identities are never emitted.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "connector",
          "entry_point",
          "retry",
          "stage",
          "reason"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana"
            ]
          },
          "connector": {
            "type": "string",
            "enum": [
              "reown"
            ]
          },
          "entry_point": {
            "type": "string",
            "enum": [
              "admin",
              "app"
            ]
          },
          "retry": {
            "type": "boolean"
          },
          "stage": {
            "type": "string",
            "enum": [
              "wallet_adapter",
              "session_check",
              "sign_out",
              "signature_request",
              "web3_sign_in",
              "session_missing"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "cancelled",
              "invalid_signature",
              "network_error",
              "wallet_unavailable",
              "session_missing",
              "auth_error"
            ]
          }
        }
      }
    },
    "project.wallet_connected": {
      "event_schema_version": 1,
      "description": "A wallet transport connects or restores an account; distinct from authenticated sign-in, deduplicated across Reown sync and sign-in retries.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "connector",
          "entry_point"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana",
              "monad",
              "robinhood",
              "apechain",
              "ethereum",
              "xrpl",
              "unknown"
            ]
          },
          "connector": {
            "type": "string",
            "enum": [
              "reown",
              "joey",
              "crossmark",
              "gem",
              "cold",
              "generated",
              "injected"
            ]
          },
          "entry_point": {
            "type": "string",
            "enum": [
              "admin",
              "app"
            ]
          }
        }
      }
    },
    "project.wallet_link_failed": {
      "event_schema_version": 1,
      "description": "Saving a connected wallet to the signed-in account failed or was cancelled.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "solana",
              "evm"
            ],
            "type": "string"
          }
        },
        "required": [
          "chain"
        ],
        "type": "object"
      }
    },
    "project.wallet_linked": {
      "event_schema_version": 1,
      "description": "A connected wallet was verified and saved to the signed-in account.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "solana",
              "evm"
            ],
            "type": "string"
          },
          "result": {
            "enum": [
              "existing_profile_moved",
              "already_linked",
              "no_profile"
            ],
            "type": "string"
          }
        },
        "required": [
          "chain",
          "result"
        ],
        "type": "object"
      }
    },
    "project.wallet_sign_in_succeeded": {
      "event_schema_version": 1,
      "description": "A Solana wallet sign-in establishes both a user and session; verified role is admin, regular, or unknown and new_account means an Auth account less than 24 hours old. Session revalidation is not counted.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "connector",
          "entry_point",
          "retry",
          "user_role",
          "account_status"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana"
            ]
          },
          "connector": {
            "type": "string",
            "enum": [
              "reown"
            ]
          },
          "entry_point": {
            "type": "string",
            "enum": [
              "admin",
              "app"
            ]
          },
          "retry": {
            "type": "boolean"
          },
          "user_role": {
            "type": "string",
            "enum": [
              "admin",
              "regular",
              "unknown"
            ]
          },
          "account_status": {
            "type": "string",
            "enum": [
              "new_account",
              "existing_account",
              "unknown"
            ]
          }
        }
      }
    },
    "project.wallet_signature_requested": {
      "event_schema_version": 1,
      "description": "The Solana sign-in adapter invokes the wallet's message-signing method; concurrent sign-ins and verified-session reuse do not create extra prompts.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "connector",
          "entry_point",
          "retry"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "solana"
            ]
          },
          "connector": {
            "type": "string",
            "enum": [
              "reown"
            ]
          },
          "entry_point": {
            "type": "string",
            "enum": [
              "admin",
              "app"
            ]
          },
          "retry": {
            "type": "boolean"
          }
        }
      }
    },
    "project.whitelist_claim_attempted": {
      "event_schema_version": 1,
      "description": "A visitor selects the whitelist or referral join action before wallet sign-in. Counts attempts, not completed registrations.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "entry_point": {
            "enum": [
              "waitroom_join",
              "waitroom_wl"
            ],
            "type": "string"
          }
        },
        "required": [
          "entry_point"
        ],
        "type": "object"
      }
    },
    "project.whitelist_claim_succeeded": {
      "event_schema_version": 1,
      "description": "Whitelist eligibility confirms the authenticated account's saved wallet registration; counted once per account per mounted waitroom eligibility check, not a unique new database enrollment.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "entry_point": {
            "enum": [
              "waitroom"
            ],
            "type": "string"
          }
        },
        "required": [
          "entry_point"
        ],
        "type": "object"
      }
    }
  }
}
